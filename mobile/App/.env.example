# Copy to .env (gitignored) to override the defaults in libs/environment.ts.
# Defaults target the Android emulator: the host machine is http://10.0.2.2.

# Backend gateway. Use the host's LAN address when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4001
# EXPO_PUBLIC_GRAPHQL_URL=http://10.0.2.2:4001/graphql
# EXPO_PUBLIC_FACE_SERVICE_URL=http://10.0.2.2:5001

# development | staging | production
# EXPO_PUBLIC_APP_ENV=development

# Cloudinary unsigned uploads for chat attachments (uploads fail with a clear error if unset).
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
